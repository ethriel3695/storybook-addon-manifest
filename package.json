{
	"name": "storybook-addon-manifest",
	"version": "0.0.3",
	"private": true,
	"description": "Monorepo for Storybook manifest addons (Angular currently supported)",
	"repository": {
		"type": "git",
		"url": "https://github.com/ethriel3695/storybook-addon-manifest"
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"changeset": "changeset",
		"check": "turbo run build format lint publint typecheck test:run --continue",
		"dev": "turbo run dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint",
		"publint": "turbo run publint",
		"release": "turbo run build && pnpm changeset publish",
		"test": "vitest",
		"test:run": "vitest run",
		"turbo": "turbo",
		"typecheck": "tsc"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.1",
		"@changesets/cli": "^2.29.6",
		"@types/node": "^20.19.0",
		"oxlint": "^1.25.0",
		"prettier": "^3.6.2",
		"publint": "^0.3.15",
		"tsdown": "^0.16.4",
		"turbo": "^2.6.1",
		"typescript": "~5.9.3",
		"vite": "^6.0.0",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.0.6"
	},
	"packageManager": "pnpm@10.19.0"
}
