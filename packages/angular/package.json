{
	"name": "storybook-addon-angular-manifest",
	"version": "0.1.1",
	"description": "Storybook addon for Angular component manifest generation with Compodoc integration",
	"keywords": [
		"storybook-addon",
		"angular",
		"compodoc",
		"mcp",
		"ai"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ethriel3695/storybook-addon-manifest",
		"directory": "packages/angular"
	},
	"license": "MIT",
	"author": "Reuben Ellis",
	"type": "module",
	"exports": {
		".": "./dist/index.mjs",
		"./preset": "./dist/preset.mjs",
		"./package.json": "./package.json"
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist/**/*",
		"README.md",
		"*.js",
		"*.d.ts"
	],
	"scripts": {
		"prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"publint": "publint"
	},
	"dependencies": {
		"comment-parser": "1.4.5",
		"empathic": "2.0.0",
		"es-toolkit": "1.44.0",
		"pathe": "2.0.3"
	},
	"peerDependencies": {
		"storybook": "^10.0.0 || ^10.2.0 || ^10.3.0"
	},
	"devDependencies": {
		"storybook": "10.2.8"
	},
	"publishConfig": {
		"access": "public"
	},
	"storybook": {
		"displayName": "Angular Manifest Generator",
		"supportedFrameworks": [
			"@storybook/angular"
		],
		"icon": "https://angular.io/assets/images/logos/angular/angular.svg"
	}
}
