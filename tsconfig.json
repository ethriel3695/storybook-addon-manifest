{
	"compilerOptions": {
		/* Base Options: */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,

		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		/* If NOT transpiling with TypeScript: */
		"module": "preserve",
		"noEmit": true,

		"lib": ["es2023", "es2024"],

		// Customization
		"allowImportingTsExtensions": true,

		// Enable live types for packages
		"paths": {
			"@storybook-manifest/angular": ["./packages/angular/src/index.ts"]
		}
	},
	"include": ["*.ts"]
}
